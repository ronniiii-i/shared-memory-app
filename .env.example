# ═══════════════════════════════════════════════════════════════
# VibeVault — Environment Variables
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your credentials.
# The backend loads from .env in the project root.
# The frontend reads VITE_* variables via Vite's built-in env.
# ═══════════════════════════════════════════════════════════════

# ── Neon Serverless PostgreSQL ─────────────────────────────────
# Get your connection string from https://console.neon.tech
# Use the pooled connection string (ending in -pooler)
DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/vibevault?sslmode=require

# ── Clerk Authentication ───────────────────────────────────────
# Get keys from https://dashboard.clerk.com → API Keys
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Cloudflare R2 Object Storage ───────────────────────────────
# Account ID: Cloudflare Dashboard → R2 → Overview
# API Token: R2 → Manage R2 API Tokens → Create API Token
# Bucket: Create a bucket in the R2 dashboard
# Public URL: Enable public access on the bucket to get this URL
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=vibevault-media
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev

# ── Pusher Real-time WebSockets ────────────────────────────────
# Get credentials from https://dashboard.pusher.com
PUSHER_APP_ID=your_pusher_app_id
PUSHER_KEY=your_pusher_key
PUSHER_SECRET=your_pusher_secret
PUSHER_CLUSTER=us2

# ── Frontend Environment (exposed to browser via Vite) ─────────
# These MUST be prefixed with VITE_ to be accessible in the frontend.
# Values should match the corresponding backend variables above.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_PUSHER_KEY=your_pusher_key
VITE_PUSHER_CLUSTER=us2
VITE_API_URL=http://localhost:3001/api

# ── Server Configuration ──────────────────────────────────────
PORT=3001
CLIENT_URL=http://localhost:5173
NODE_ENV=development
